theorem neutron_floor_true (x N sigma phi0 phi : ℝ) (dom_x : 0 < x) (dom_N : 0 < N) (dom_sigma : 0 < sigma) (dom_phi0 : 0 < phi0) (dom_c1 : phi ≤ (phi0 / (10 : ℝ))) (h_flux_ge_uncollided : A_flux_ge_uncollided phi phi0 N sigma x) (h_max_atom_density : A_max_atom_density N) (h_max_sigma_total_14mev : A_max_sigma_total_14mev sigma) :
